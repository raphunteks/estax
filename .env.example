# Public (safe to expose, used for links and SEO)
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_WA_NUMBER=62xxxxxxxxxxx
NEXT_PUBLIC_PHONE=+62xxxxxxxxxxx
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_MAPS_URL=
NEXT_PUBLIC_INSTAGRAM=

# Server only (never commit real values)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_USER=admin
ADMIN_PASSWORD=

# Upstash Redis / Vercel KV
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 9Router (AI gateway). Server-side only; never prefix with NEXT_PUBLIC_.
NINEROUTER_BASE_URL=http://43.134.43.146:20128/v1
NINEROUTER_MODEL=estaka-combos
NINEROUTER_API_KEY=
# Optional: STT model id (default: first from GET /models/stt)
NINEROUTER_STT_MODEL=
# The router endpoint is plain HTTP; production refuses it unless you set this to 1 (or use HTTPS).
AI_ALLOW_INSECURE_HTTP=

# --- RM-E auth (fill in .env.local, never commit real values) ---
AUTH_SECRET=
ENCRYPTION_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM=
NEXT_PUBLIC_SITE_URL=
SEED_SUPERADMIN_1_EMAIL=
SEED_SUPERADMIN_1_PASSWORD=
SEED_SUPERADMIN_1_NAME=
SEED_SUPERADMIN_2_EMAIL=
SEED_SUPERADMIN_2_PASSWORD=
SEED_SUPERADMIN_2_NAME=
BLOB_READ_WRITE_TOKEN=

# --- Phase 4: reminders (all optional; server only) ---
# Hermes Agent webhook route (direct WhatsApp delivery). https required in production.
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=
# Suffix appended to the phone number to build chat_id (default @s.whatsapp.net)
HERMES_WA_CHAT_SUFFIX=
# Shared secret for /api/cron/reminders (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Web Push (generate once: npx web-push generate-vapid-keys). Server-side only; the public key is served by /api/push/key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example
